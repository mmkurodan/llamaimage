<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Model downloads (Hugging Face, via the system DownloadManager) and the loopback LLM API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Image generation API (ImageApiService): a foreground service other apps start on demand,
         a partial wake lock while generating, and its status notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- We talk to the com.micklab.llama Ollama-compatible server (loopback) and may launch it. -->
    <queries>
        <package android:name="com.micklab.llama" />
    </queries>

    <application
        android:label="llamaimage"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- GPU generation (libsd_jni_gpu.so) links the device's own OpenCL driver. Apps targeting
             API 31+ must declare vendor libraries they load; optional, so devices without OpenCL
             still install (the CPU library is used there). -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <!-- configChanges: the code-built UI adapts to these by itself. Without it, rotating or
             resizing recreated the Activity, which lost the image/inputs and re-ran startup. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Image generation API (127.0.0.1:8766). Exported so other apps can switch it on/off:
             explicit Intent to this component with action com.micklab.llamaimage.START_SERVICE
             (optional int extra "port") or com.micklab.llamaimage.STOP_SERVICE. -->
        <service
            android:name=".api.ImageApiService"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_image_generation_api_server" />
        </service>

        <!-- Invisible trampoline: other apps launch it (explicit Intent, action
             com.micklab.llamaimage.START_SERVICE, optional int extra "port") when an OEM
             "AutoLaunch" block refuses the direct cross-app service start. -->
        <activity
            android:name=".api.ApiStartActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
